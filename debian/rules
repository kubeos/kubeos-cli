#!/usr/bin/make -f
%:
	dh $@

# Only /etc/kubeos/kubeos.conf is a conffile in KubeOS; every other /etc file this
# platform generates at first boot is not shipped at all (see PACKAGING-DECISIONS D5).
override_dh_installdeb:
	dh_installdeb
	printf '%s\n' /etc/kubeos/kubeos.conf > debian/kubeos-cli/DEBIAN/conffiles

# dh_installsystemd would enable and start/restart every unit in this package on its own,
# which makes flanneld run: hook 9050 says it must stay disabled, because it cannot run as a
# host service. --no-enable is the whole fix - enabling is the only thing to prevent, and the
# .wants links shipped in the package state exactly which units are enabled on a fresh install.
# --no-start must NOT be added: it also stops the units during an upgrade and never starts
# them again, which took the entire control plane down on 2026-11-19 (measured). Restarting a
# unit around a binary replacement is what Debian does, and it is what we want.
override_dh_installsystemd:
	dh_installsystemd --no-enable
